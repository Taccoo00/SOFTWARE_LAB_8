# Copy this file to .env only if you use a local environment loader.
# Never commit the real values.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
SECRET_KEY=replace-with-a-long-random-secret

# Brevo SMTP credentials. Use the SMTP login and Master Password shown in
# Brevo's SMTP & API settings. BREVO_SENDER_EMAIL must be a verified sender.
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-master-password
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=RoseLab Hardware Inventory

# Optional overrides (these defaults already match the Lab 9 instructions).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Use 0 only for local HTTP development. Keep 1 on Render (HTTPS).
SESSION_COOKIE_SECURE=1
